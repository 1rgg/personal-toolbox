# CS2 Events Hub 运行时配置
# 由 systemd 通过 EnvironmentFile= 注入

# 监听端口。必须显式指定：server.js 在未设置 PORT 时会自动往后找空闲端口，
# 生产环境里端口漂移会让人排查不到问题。
PORT=5173

# 只监听回环，公网访问一律经 Nginx 转发。
# 这样即使安全组误放开 5173，Node 进程也不会直连暴露。
HOST=127.0.0.1

# Liquipedia 接口条款要求 UA 里带可联系到你的信息。
# 换成你自己的邮箱后再上线。
LIQUIPEDIA_UA=CS2EventsHub/1.0 (1687939609@qq.com)

# 赛事时间轴缓存 30 分钟
CACHE_TTL_MS=1800000

# 页面内容缓存 6 小时
PAGE_TTL_MS=21600000

# 两次请求的最小间隔。README 明确要求不要调小，
# 调小会触发 Liquipedia 的 IP 封禁。
MIN_GAP_MS=3000

# 被限流后的冷却时长 30 分钟
COOLDOWN_MS=1800000

# 第三方接口（快递 / 12306）凭据，只在服务端使用
APIHZ_ID=
APIHZ_KEY=
